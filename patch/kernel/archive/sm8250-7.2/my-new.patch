+	     || type == LOAD_PANEL_CX_TOT_MS_KEY
+	     || type == LOAD_PANEL_CX_TOT_MS_FORCE)) {
+		logError(1,
+			 "%s %s: Choose a TOT MS type of compensation data ERROR %08X\n",
+			 tag, __func__, ERROR_OP_NOT_ALLOW);
