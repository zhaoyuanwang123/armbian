+
+	logError(0, "%s Global data Read !\n", tag);
+
+	global->header.force_node = data[0];
+	global->header.sense_node = data[1];
+
+	logError(0, "%s force_len = %d sense_len = %d  \n", tag,
+		 global->header.force_node, global->header.sense_node);
