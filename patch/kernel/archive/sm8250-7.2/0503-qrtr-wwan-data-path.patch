+		"qrtr %s #%d v%u type=%u(%s) src=%u:%u dst=%u:%u payload=%u len=%zu\n",
+		dir, n, version, type, qrtr_pkt_type_name(type),
+		src_node, src_port, dst_node, dst_port, payload_len, len);
