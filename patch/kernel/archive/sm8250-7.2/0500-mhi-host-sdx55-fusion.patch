+					 "Failed to map MSI page 0x%pa in SMMU: %d\n",
+					 &msi_page, err);
+			else
+				dev_info(&pdev->dev,
+					 "MSI target page 0x%pa mapped in SMMU domain (type %d)\n",
+					 &msi_page, domain->type);
+		} else {
+			dev_warn(&pdev->dev,
+				 "endpoint MSI address is zero, MSIs will fault\n");
+		}
