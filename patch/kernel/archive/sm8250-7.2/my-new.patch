+static void j2_mp_42_02_0b_dsc_remove(struct mipi_dsi_device *dsi)
+{
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+}
