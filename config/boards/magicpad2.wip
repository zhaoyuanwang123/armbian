# Honor MagicPad 2 (SM8650)
declare -g BOARD_NAME="Honor MagicPad 2"
declare -g BOARD_VENDOR="honor"
declare -g BOARD_MAINTAINER="zhao"
declare -g INTRODUCED="2024"
declare -g BOARDFAMILY="sm8650-abl"
declare -g KERNEL_TARGET="edge,current"
declare -g EXTRAWIFI="no"
declare -g BOOTCONFIG="none"
declare -g IMAGE_PARTITION_TABLE="gpt"
declare -g -a ABL_DTB_LIST=("sm8650-magicpad2")
declare -g BOOTIMG_CMDLINE_EXTRA="udmabuf.size_limit_mb=256 quiet"
declare -g BOARD_FIRMWARE_INSTALL="-full"

function magicpad2_is_userspace_supported() {
	[[ "${RELEASE}" == "trixie" ]] && return 0
	[[ "${RELEASE}" == "noble" ]] && return 0
	return 1
}

function magicpad2_is_userspace_supported_alert() {
	if ! magicpad2_is_userspace_supported; then
		if [[ "${RELEASE}" != "" ]]; then
			display_alert "Missing userspace for ${BOARD}" "${RELEASE} does not have the userspace necessary to support the ${BOARD}" "warn"
		fi
		return 1
	fi
	return 0
}

function post_family_tweaks__magicpad2_enable_services() {
	magicpad2_is_userspace_supported_alert || return 0

	mv "${SDCARD}"/etc/apt/sources.list.d/armbian.sources.disabled "${SDCARD}"/etc/apt/sources.list.d/armbian.sources

	do_with_retries 3 chroot_sdcard_apt_get_update
	display_alert "$BOARD" "Installing board tweaks" "info"
	do_with_retries 3 chroot_sdcard_apt_get_install qbootctl qrtr-tools unudhcpd mkbootimg dropbear-bin

	mv "${SDCARD}"/etc/apt/sources.list.d/armbian.sources "${SDCARD}"/etc/apt/sources.list.d/armbian.sources.disabled
	do_with_retries 3 chroot_sdcard_apt_get_update

	# NOTE: 这些服务文件来自 packages/bsp/*，本板还没准备，先不 enable
	# chroot_sdcard systemctl enable qbootctl.service
	# chroot_sdcard systemctl enable usbgadget-rndis.service
	# chroot_sdcard systemctl enable bt-fixed-mac.service
	return 0
}

function post_family_tweaks_bsp__magicpad2_bsp_firmware_in_initrd() {
	display_alert "Adding to bsp-cli" "${BOARD}: firmware in initrd" "info"
	declare file_added_to_bsp_destination
	add_file_from_stdin_to_bsp_destination "/etc/initramfs-tools/hooks/magicpad2-firmware" <<- 'FIRMWARE_HOOK'
		#!/bin/bash
		[[ "$1" == "prereqs" ]] && exit 0
		. /usr/share/initramfs-tools/hook-functions
		for f in $(find /lib/firmware/qcom/sm8650/magicpad2 -type f 2>/dev/null) ; do
			add_firmware "${f#/lib/firmware/}"
		done
		for f in $(find /lib/firmware/ath12k/WCN7850 -type f 2>/dev/null) ; do
			add_firmware "${f#/lib/firmware/}"
		done
		for f in $(find /lib/firmware/qca -type f 2>/dev/null) ; do
			add_firmware "${f#/lib/firmware/}"
		done
	FIRMWARE_HOOK
	run_host_command_logged chmod -v +x "${file_added_to_bsp_destination}"
}
