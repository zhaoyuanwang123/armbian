+	if (ret < OK) {
+		logError(1, "%s Error during reading FW file! ERROR %08X\n",
+			 tag, ret);
+	} else {
+		logError(1, "%s %s, size = %d bytes\n", tag,
+			 printHex("EXT Release = ", systemInfo.u8_releaseInfo,
+				  EXTERNAL_RELEASE_INFO_SIZE, temp),
