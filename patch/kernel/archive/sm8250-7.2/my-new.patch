+
+		return (ERROR_TEST_CHECK_FAIL | ERROR_PROD_TEST_DATA);
+	}
+
+ERROR_LIMITS:
+
+	if (thresholds != NULL)
+		kfree(thresholds);
+
+	if (thresholds_min != NULL)
