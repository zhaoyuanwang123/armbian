+	/* SS TOTAL CX SENSE */
+	dev_info(info->dev, "SS TOTAL CX LP SENSE TEST:\n");
+	if (todo->SelfSenseCxTotalLP == 1 || todo->SelfSenseCxTotalAdjLP == 1) {
+		dev_info(info->dev, "SS TOTAL CX LP SENSE MIN MAX TEST:\n");
